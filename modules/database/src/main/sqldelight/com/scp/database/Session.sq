CREATE TABLE session (
    id          TEXT NOT NULL PRIMARY KEY,
    project_id  TEXT NOT NULL REFERENCES project(id),
    tool_name   TEXT NOT NULL,
    start_time  TEXT NOT NULL,
    end_time    TEXT,
    summary     TEXT NOT NULL DEFAULT '',
    token_usage INTEGER,
    status      TEXT NOT NULL DEFAULT 'open' CHECK (status IN ('open', 'closed')),
    -- The resume anchor: what the NEXT agent should pick up. summary says what happened;
    -- next_step says where to start. Read back first by hydrate_context (docs/05 §5 section 0),
    -- which is why it is a first-class column and not a convention inside summary.
    next_step   TEXT NOT NULL DEFAULT '',
    -- start_time as a sortable integer. start_time itself is ISO-8601 TEXT whose fractional
    -- part is 0, 3, 6 or 9 digits wide (kotlinx Instant.toString() trims trailing zero groups),
    -- and TEXT comparison is not chronological across those widths: 'Z' (0x5A) outranks both
    -- '.' (0x2E) and every digit, so '...:34.732Z' sorts AFTER '...:34.732767700Z' and a
    -- whole-second timestamp sorts after every fractional one in its second. Ordering the
    -- resume anchor that way hands the next agent an older session. Every ORDER BY and range
    -- filter on session time uses this column; start_time stays as the human-readable form.
    start_time_epoch_nanos INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX idx_session_project_status ON session(project_id, status);
CREATE INDEX idx_session_start_time     ON session(start_time);
CREATE INDEX idx_session_start_nanos    ON session(project_id, start_time_epoch_nanos);

insertSession:
INSERT INTO session(id, project_id, tool_name, start_time, end_time, summary, token_usage, status, next_step, start_time_epoch_nanos)
VALUES (:id, :projectId, :toolName, :startTime, :endTime, :summary, :tokenUsage, :status, :nextStep, :startTimeEpochNanos);

findById:
SELECT * FROM session WHERE id = :id;

findOpenByProject:
SELECT * FROM session WHERE project_id = :projectId AND status = 'open' ORDER BY start_time_epoch_nanos;

closeSession:
UPDATE session
SET status      = 'closed',
    end_time    = :endTime,
    summary     = COALESCE(:summary, summary),
    token_usage = COALESCE(:tokenUsage, token_usage),
    next_step   = COALESCE(:nextStep, next_step)
WHERE id = :id;

-- The resume anchor for hydrate_context: the most recently STARTED session, open or closed.
-- Deliberately not "most recently closed" — an open session from a crashed agent is still
-- where work stopped, and hiding it would send the next agent to older, staler state.
findLatest:
SELECT * FROM session WHERE project_id = :projectId ORDER BY start_time_epoch_nanos DESC LIMIT 1;

listRecent:
SELECT * FROM session WHERE project_id = :projectId ORDER BY start_time_epoch_nanos DESC LIMIT :limit;

listChronological:
SELECT * FROM session WHERE project_id = :projectId ORDER BY start_time_epoch_nanos;

countByProject:
SELECT count(*) FROM session WHERE project_id = :projectId;

findOpenOlderThan:
SELECT * FROM session
WHERE status = 'open' AND start_time_epoch_nanos < :cutoffEpochNanos
ORDER BY start_time_epoch_nanos;
