CREATE TABLE file (
    id         TEXT NOT NULL PRIMARY KEY,
    project_id TEXT NOT NULL REFERENCES project(id),
    path       TEXT NOT NULL,
    summary    TEXT NOT NULL DEFAULT '',
    hash       TEXT NOT NULL DEFAULT '',
    updated_at TEXT NOT NULL,
    UNIQUE (project_id, path)
);

CREATE INDEX idx_file_project_updated ON file(project_id, updated_at);

upsertFile:
INSERT INTO file(id, project_id, path, summary, hash, updated_at)
VALUES (:id, :projectId, :path, :summary, :hash, :updatedAt)
ON CONFLICT(project_id, path) DO UPDATE SET
    summary    = excluded.summary,
    hash       = excluded.hash,
    updated_at = excluded.updated_at;

findRecentlyModified:
SELECT * FROM file WHERE project_id = :projectId ORDER BY updated_at DESC LIMIT :limit;

listByProject:
SELECT * FROM file WHERE project_id = :projectId ORDER BY path;
